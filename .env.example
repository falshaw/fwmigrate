# Copy to .env and replace every value. Generate secrets with: openssl rand -base64 32

# PostgreSQL superuser (used for schema push / admin only)
POSTGRES_PASSWORD=change-me
# Least-privilege application role created by postgres/init-user.sh
FWMIGRATE_DB_PASSWORD=change-me
# Redis auth
REDIS_PASSWORD=change-me
# NextAuth session secret
AUTH_SECRET=change-me
NEXTAUTH_URL=http://localhost:3004

# Local development only (docker compose builds DATABASE_URL for the container itself)
DATABASE_URL=postgresql://postgres:change-me@127.0.0.1:5436/fwmigrate

# Optional: password for the seeded admin user (random if unset)
SEED_ADMIN_PASSWORD=

# AI provider: "ollama" (default) or "claude" (via an authenticated LLM gateway)
LLM_PROVIDER=ollama
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b
CLAUDE_BRIDGE_URL=http://host.docker.internal:7777
CLAUDE_BRIDGE_TOKEN=
CLAUDE_MODEL=opus

# Optional: external change-management system that approved rules are pushed to
CHANGE_MANAGER_API_URL=http://localhost:3003
CHANGE_MANAGER_API_KEY=

# Only needed by src/lib/crypto.ts (64 hex chars): openssl rand -hex 32
ENCRYPTION_KEY=
