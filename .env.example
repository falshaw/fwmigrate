# Copy to .env, then fill in the four secrets below.
# Generate each one with either command (both work on Windows, macOS and Linux):
#   openssl rand -hex 32
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# docker compose refuses to start while any of the four is empty.

# PostgreSQL superuser (schema push, seed and admin only)
POSTGRES_PASSWORD=
# Least-privilege application role created by postgres/init-user.sh
FWMIGRATE_DB_PASSWORD=
# Redis auth
REDIS_PASSWORD=
# NextAuth session secret: at least 32 characters (openssl rand -hex 32 gives 64)
AUTH_SECRET=

# Host ports (all bound to 127.0.0.1). Change them if they clash with something else.
APP_PORT=3004
POSTGRES_PORT=5436
REDIS_HOST_PORT=6383
# Public URL of the app; keep the port in line with APP_PORT
NEXTAUTH_URL=http://localhost:3004

# Optional: password for the seeded admin user (random and printed if unset)
SEED_ADMIN_PASSWORD=

# Optional LLM. FW Migrate works fully without one: translation is deterministic.
# An LLM only adds zone-mapping suggestions and per-rule explanations.
#   none    - no LLM (default)
#   ollama  - Ollama API at OLLAMA_HOST with OLLAMA_MODEL
#   claude  - authenticated HTTP LLM gateway (CLAUDE_BRIDGE_URL + token)
LLM_PROVIDER=none
OLLAMA_HOST=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:14b
# Per-call timeout, parallel calls and number of rules explained per run
LLM_TIMEOUT_MS=90000
LLM_CONCURRENCY=1
LLM_EXPLAIN_MAX_RULES=50
CLAUDE_BRIDGE_URL=http://host.docker.internal:7777
CLAUDE_BRIDGE_TOKEN=
CLAUDE_MODEL=sonnet

# Optional: external change-management system that approved rules are pushed to
CHANGE_MANAGER_API_URL=
CHANGE_MANAGER_API_KEY=

# Only needed by src/lib/crypto.ts (64 hex chars): openssl rand -hex 32
ENCRYPTION_KEY=

# DATABASE_URL is normally NOT needed: compose builds it for the container, and
# the Prisma CLI / seed / `npm run dev` build it from POSTGRES_PASSWORD and
# POSTGRES_PORT. Set it only to point at a different database.
# DATABASE_URL=postgresql://postgres:<password>@127.0.0.1:5436/fwmigrate
